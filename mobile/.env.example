EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_TENH_API_URL=https://app.tenhchat.com

# Optional: a {z}/{x}/{y} raster tile template for the location picker, e.g.
# https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_KEY
# Left unset, the picker works without imagery. OpenStreetMap's own tile
# servers are volunteer-run and their usage policy excludes apps like this --
# they refuse the request and serve a placeholder.
EXPO_PUBLIC_MAP_TILE_URL=
