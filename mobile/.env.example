# Optional override for the location picker's {z}/{x}/{y} raster template.
# Unset: https://tile.openstreetmap.org/{z}/{x}/{y}.png (best-effort, no SLA).
# Follow https://operations.osmfoundation.org/policies/tiles/.
# An explicit empty value disables imagery. Other providers may need their
# own licence attribution; review their terms before changing the template.
# EXPO_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
