{
  "manifest_version": 3,
  "name": "TENH Companion — Localhost",
  "version": "1.2.32",
  "description": "TENH development companion for http://localhost:3000, with isolated local connection state.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "sidePanel",
    "tabs",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://www.facebook.com/*",
    "https://business.facebook.com/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:3000/*"
      ],
      "js": [
        "src/tenh-bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.facebook.com/*",
        "https://business.facebook.com/*"
      ],
      "js": [
        "src/facebook-selectors.js",
        "src/facebook-profile-resolver.js",
        "src/facebook-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "TENH Companion — Localhost",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "src/sidepanel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
