{
  "manifest_version": 3,
  "name": "TENH v1",
  "version": "1.1.0",
  "description": "Your TENH Chat customer, tags, notes and quick replies beside Facebook. Optional — TENH works exactly the same without it.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "notifications", "sidePanel", "tabs", "alarms"],
  "host_permissions": [
    "https://app.tenhchat.com/*",
    "https://www.facebook.com/*",
    "https://business.facebook.com/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://app.tenhchat.com/*"],
      "js": ["src/tenh-bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.facebook.com/*",
        "https://business.facebook.com/*"
      ],
      "js": ["src/facebook-selectors.js", "src/facebook-bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "TENH v1",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "src/sidepanel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
