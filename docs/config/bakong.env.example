# Documentation only. Configure through the existing server secret manager after review.
# Leave checkout disabled until the migration and explicit general authorization are approved.
BAKONG_CHECKOUT_ENABLED=false
# Separate, reviewed, expiring one-workspace authorization is ALSO required. Default off.
BAKONG_PILOT_ENABLED=false
BAKONG_ENVIRONMENT=sandbox
BAKONG_API_CONTRACT=v1-md5
BAKONG_API_BASE_URL=https://sit-api-bakong.nbc.gov.kh
BAKONG_ACCOUNT_TYPE=individual
BAKONG_API_TOKEN=
BAKONG_ACCOUNT_ID=
# Required only for BAKONG_ACCOUNT_TYPE=merchant; omit for individual accounts.
BAKONG_MERCHANT_ID=
# SDK payee/display name, also required for individual accounts.
BAKONG_MERCHANT_NAME=
BAKONG_MERCHANT_CITY=
# Optional for individual; required for merchant. Use the bank-confirmed value.
BAKONG_ACQUIRING_BANK=
BAKONG_DAILY_REQUEST_BUDGET=90

# Production uses BAKONG_ENVIRONMENT=production and exactly:
# BAKONG_API_BASE_URL=https://api-bakong.nbc.gov.kh
# It ALSO requires a matching private general operator authorization OR provider-reviewed capacity.
# Operator attestation of a dedicated 100/day token permits at most 90 calls per rolling 24h;
# provider eligibility remains not-independently-verified. Never relabel this as provider verification.
# Every attempt reserves 3 inquiries and has a shared lifetime cap of 3, including failures/crashes.
# The expired pilot is retained; issued pilot attempts keep their original restrictions.
# Never prefix these settings with NEXT_PUBLIC or store real secrets in this file.
