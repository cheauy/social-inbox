# Copy this file to ".env" in this same folder and fill in the values.
# ".env" is gitignored. Never commit it or paste it into chat.

# Keep true only when you want this worker running.
TELEGRAM_PERSONAL_WORKER_ENABLED=true

# From my.telegram.org (TENH's own app).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# From: node src/keygen.ts --kek
TELEGRAM_PERSONAL_KEK=

# Path to the private key file created by: node src/keygen.ts C:\Users\TUF\tgp-seal.pem
TELEGRAM_PERSONAL_SEAL_PRIVATE_KEY_FILE=C:\Users\TUF\tgp-seal.pem

# Supabase -> Connect -> Session pooler connection string (port 5432), with your DB password.
TELEGRAM_PERSONAL_DATABASE_URL=

# Folder where encrypted Telegram session data is stored. Must stay the same.
TELEGRAM_PERSONAL_DATA_DIR=C:\Users\TUF\tgp-data

# Stable name for this machine. Must stay the same.
TELEGRAM_PERSONAL_WORKER_ID=local-pc
